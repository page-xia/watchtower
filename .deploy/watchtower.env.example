# Copy to /root/watchtower/watchtower.env and fill secrets on the server.
# Never commit the populated file.
WATCH_HOST=0.0.0.0
WATCH_PORT=8788

# Principal-scoped personal state (production must use the dedicated RDS DB).
WATCH_USER_STORE_BACKEND=mysql
WATCH_USER_MYSQL_HOST=your-rds-endpoint.mysql.rds.aliyuncs.com
WATCH_USER_MYSQL_PORT=3306
WATCH_USER_MYSQL_USER=watchtower_user
WATCH_USER_MYSQL_PWD=
WATCH_USER_MYSQL_DB=watchtower_user
WATCH_USER_MYSQL_CONNECT_TIMEOUT=5
WATCH_USER_MYSQL_POOL_SIZE=4

# Shared message and EOD stores (optional for a local smoke run).
WATCH_MESSAGE_STORE_BACKEND=mysql
WATCH_MSG_MYSQL_HOST=your-rds-endpoint.mysql.rds.aliyuncs.com
WATCH_MSG_MYSQL_PORT=3306
WATCH_MSG_MYSQL_USER=watchtower
WATCH_MSG_MYSQL_PWD=
WATCH_MSG_MYSQL_DB=watchtower_msg
WATCH_EOD_STORE_BACKEND=mysql
WATCH_EOD_MYSQL_HOST=your-rds-endpoint.mysql.rds.aliyuncs.com
WATCH_EOD_MYSQL_PORT=3306
WATCH_EOD_MYSQL_USER=watchtower
WATCH_EOD_MYSQL_PWD=
WATCH_EOD_MYSQL_DB=watchtower_eod

# The bootstrap command creates only principal_* tables; it never imports
# data/watchlist.json or data/positions.json.
